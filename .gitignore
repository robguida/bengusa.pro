# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/src/node_modules
/src/.pnp
.pnp.*
/src/.yarn/*
!/src/.yarn/patches
!/src/.yarn/plugins
!/src/.yarn/releases
!/src/.yarn/versions

# testing
/src/coverage
/src/test-results/
/src/playwright-report/
/src/blob-report/
/src/playwright/.cache/

# next.js
/src/.next/
/src/out/

# production
/src/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: never commit real values; only the template is tracked
.env*
!.env.template

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local helpers and editor settings
/.idea
dev.cmd
