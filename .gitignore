# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (two installs: the site in src/, the test suite in tests/)
/src/node_modules
/tests/node_modules
/src/.pnp
.pnp.*
/src/.yarn/*
!/src/.yarn/patches
!/src/.yarn/plugins
!/src/.yarn/releases
!/src/.yarn/versions

# testing
/src/coverage
/tests/test-results/
/tests/playwright-report/
/tests/blob-report/
/tests/playwright/.cache/
# the test suite's throwaway copies of the site
/src/.fixture-sites/

# next.js
/src/.next/
/src/out/

# production
/src/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: never commit real values; only the template is tracked
.env*
!.env.template

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local helpers and editor settings
/.idea
dev.cmd

# visit reports and extracted data (local only, never shipped)
/analytics/
