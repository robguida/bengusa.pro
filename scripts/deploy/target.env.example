# Template for one deploy target's settings. Placeholder values only.
# Copy it OUTSIDE the repo, one file per target:
#   Windows: %LOCALAPPDATA%\bengusa-deploy\targets\preview.env  and  live.env
#   Linux:   ~/.local/state/bengusa-deploy/targets/preview.env  and  live.env
# deploy.mjs refuses a settings file or a key file inside the repo.
# Nothing here is a secret, but real values stay out of the repo anyway.

# Must match the file name: preview or live.
DEPLOY_TARGET=preview
# The server's static IP or host name.
DEPLOY_HOST=203.0.113.10
# The site's deploy user on the server (no sudo).
DEPLOY_USER=dp-example
# Private key for that user. Absolute path, outside the repo. Never copied or printed.
DEPLOY_KEY=X:\path\outside\the\repo\example-key.pem
# The server's ed25519 HOST key, "ssh-ed25519 AAAA..." with no comment. Read it from
# the Lightsail browser SSH window (cat /etc/ssh/ssh_host_ed25519_key.pub) and check
# its fingerprint there (ssh-keygen -lf). deploy.mjs pins it: no trust-on-first-use.
DEPLOY_HOSTKEY=ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIEXAMPLEEXAMPLEEXAMPLEEXAMPLEEXAMPLEEXAMPLE0
# The site folder on the server: releases/ and current live here.
DEPLOY_SITE_ROOT=/srv/sites/preview.example.invalid
# The site's address (https, no path). Preview must start with https://preview.
DEPLOY_URL=https://preview.example.invalid
# Optional: which ssh to use. Default on Windows: Git's ssh.exe.
# DEPLOY_SSH=C:\Program Files\Git\usr\bin\ssh.exe
